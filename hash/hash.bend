def crc.byte(h: U32, +c: U32) -> U32:
  +x = h
  (crc.tab(((x .^. c) .&. 255 : U32)) .^. (x >> 8n) : U32)

def crc.word(h: U32, +w: U32) -> U32:
  +x = (h .^. w : U32)
  (((crc.tab3((x .&. 255 : U32)) .^. crc.tab2(((x >> 8n) .&. 255 : U32))) .^. crc.tab1(((x >> 16n) .&. 255 : U32))) .^. crc.tab((x >> 24n : U32)) : U32)

def crc.lane(h: U32, +m: W64) -> U32:
  match m:
    case W64{+hi, +lo}:
      +x = (h .^. lo : U32)
      +p = (((crc.tab7((x .&. 255 : U32)) .^. crc.tab6(((x >> 8n) .&. 255 : U32))) .^. crc.tab5(((x >> 16n) .&. 255 : U32))) .^. crc.tab4((x >> 24n : U32)) : U32)
      +q = (((crc.tab3((hi .&. 255 : U32)) .^. crc.tab2(((hi >> 8n) .&. 255 : U32))) .^. crc.tab1(((hi >> 16n) .&. 255 : U32))) .^. crc.tab((hi >> 24n : U32)) : U32)
      (p .^. q : U32)

# After the lanes: one word when len % 8 >= 4, then the bytes.
def crc.rest(+len: U32, r: Array<U32> & U32) -> Bytes.Bytes & U32:
  (a, h) = r
  bytewise.rest(~U32, ~crc.byte, len, wfrom(~U32, ~crc.word, U32.to_nat(((len >> 2n) .&. 1 : U32)), a, ((len >> 3n) << 1n : U32), h))

def crc.fin(r: Bytes.Bytes & U32) -> Bytes.Bytes & U32:
  (b, +h) = r
  (b, (h .^. 4294967295 : U32))

